# TryOn Anywear backend configuration
# Copy to .env and adjust values as needed

TRYON_PROVIDER=mock
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Image processing
MAX_UPLOAD_BYTES=5242880
MIN_IMAGE_DIMENSION=128
MAX_IMAGE_DIMENSION=8000
WORKING_MAX_DIMENSION=1600
JPEG_QUALITY=90

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600
TRUST_FORWARDED_FOR=false
TRUST_PROXY_HOPS=1

# Jobs
JOB_TTL_SECONDS=600
JOB_REAPER_INTERVAL_SECONDS=30
MAX_CONCURRENT_JOBS=2

# Provider settings
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2
MOCK_DELAY_SECONDS=0.6

# Replicate (IDM-VTON)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=cuuupid/idm-vton:0513734a14f04a7ae3e5c81de8ff3c57
REPLICATE_STEPS=30

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-nano-banana-2.1

# Logging / environment
ENVIRONMENT=development
LOG_LEVEL=INFO
